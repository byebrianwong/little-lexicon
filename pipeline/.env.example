# Pipeline environment (server-side only).
#
# This file lists the keys the offline pipeline reads. Copy it to pipeline/.env
# and fill real values there. The real .env is git-ignored (see root .gitignore:
# "pipeline/.env"). None of these values belong in the app bundle or in any
# EXPO_PUBLIC_* variable. See CLAUDE.md > Secrets.
#
# Every key is optional. Without one, its stage is skipped and the free stages
# (Datamuse, Open English WordNet, export) still run. With --dry-run the
# pipeline makes no network calls at all and writes only to pipeline/out/.

# --- Anthropic Claude (batch generation, stage 03) ---
ANTHROPIC_API_KEY=sk-ant-your-key

# --- Google Gemini (alternative for stage 03) ---
# Used only when ANTHROPIC_API_KEY is not set. Key from Google AI Studio.
# GEMINI_API_KEY=your-gemini-api-key
# Optional: model id (default gemini-3.8-flash).
# GEMINI_MODEL=gemini-3.8-flash

# --- Text to speech (stage 04) ---
# Provider choice: Google Cloud Text-to-Speech (Neural2 voices).
# Why: generous monthly free tier (1M Neural2 chars/month) that likely covers
# the whole one-time corpus, returns MP3 directly, and authenticates with a
# simple API key (no service-account JSON needed for the REST synthesize call).
# Endpoint: https://texttospeech.googleapis.com/v1/text:synthesize?key=...
# Cost past the free tier is about $16 per 1M characters for Neural2.
GOOGLE_TTS_API_KEY=your-google-tts-api-key

# Optional overrides (safe defaults are used if unset):
# GOOGLE_TTS_VOICE=en-US-Neural2-D
# GOOGLE_TTS_LANGUAGE=en-US
