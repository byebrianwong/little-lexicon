{
  "name": "little-lexicon-pipeline",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Offline build-time content and audio pipeline for the Little Lexicon app. Not shipped in the app bundle.",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc --noEmit",
    "start": "tsx src/run.ts",
    "test": "tsx src/run.ts --dry-run --limit=20"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "0.112.3",
    "@supabase/supabase-js": "2.49.4",
    "dotenv": "16.6.1",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@types/node": "22.20.1",
    "tsx": "4.19.2",
    "typescript": "5.9.2"
  }
}
