# App (client-safe) environment.
# Only EXPO_PUBLIC_* values belong here. Server secrets NEVER go in this file
# or in the app bundle. See pipeline/.env.example and Supabase Edge Function
# secrets for ANTHROPIC_API_KEY, TTS keys, and SUPABASE_SERVICE_ROLE_KEY.

# Supabase (shared "games-apps" project)
EXPO_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-ref.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Optional: the two Claude features ("Make it personal" and the sentence
# check). Set to true only after the little-lexicon-generate-personalized and
# little-lexicon-evaluate-sentence Edge Functions are deployed with an
# ANTHROPIC_API_KEY secret. Each use is a paid API call.
EXPO_PUBLIC_AI_FEATURES=false

# Optional: offer "Continue with Google". Needs Google set up as a provider in
# the Supabase project's Auth settings first.
EXPO_PUBLIC_GOOGLE_SIGN_IN=false

# Optional: run the app against local seed data with no Supabase connection.
# Useful for design review and offline development.
EXPO_PUBLIC_DEMO_MODE=true
